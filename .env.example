# Copy to .env (repo root) and fill in what you use. Never commit .env.
# The cut → clean → TSX → SFX core needs AssemblyAI + ElevenLabs; Gemini is only for thumbnails.
# yt_upload / yt_stats use OAuth, not a key here (see tools/yt_upload_SETUP.md and CLAUDE.md).

# AssemblyAI — transcription for the cut pipeline (tools/transcribe.py). Required for /clean-cut.
# https://assemblyai.com
ASSEMBLYAI_API_KEY=

# ElevenLabs — voice isolation (tools/clean_voice.py --method eleven), SFX generation
# (tools/gen_sfx.py), music beds (tools/gen_music.py), and Shorts narration
# (tools/gen_voiceover.py, /make-short). Needed for /clean-audio + /suggest-sfx + the Shorts pipeline.
# /clean-audio's local RNNoise method needs no key if you would rather skip this one.
# https://elevenlabs.io
ELEVENLABS_API_KEY=

# The ElevenLabs voice for Shorts narration (tools/gen_voiceover.py).
# Pick one voice and KEEP it — the channel's voice is part of the brand (see brand.md §1).
# ToolMint's locked voice is Liam: TX3LPaxmHKxFdv7VOQHJ
ELEVENLABS_VOICE_ID=

# Replicate — FLUX image generation (tools/gen_image.py), the DEFAULT art backend.
# ~$0.003/image vs ~$0.034 on Gemini's cheapest tier. We never ask an image model to render
# TEXT (Remotion sets every headline + the wordmark), so the cheapest strong ART model wins.
# gen_image.py falls back to Gemini lite automatically if this is missing.
# https://replicate.com/account/api-tokens
REPLICATE_API_KEY=

# Google Gemini — image/thumbnail generation (tools/gen_thumbnail.py, /packaging, and the
# gen_image.py fallback). Nano Banana Pro is still the pick when an image must render text.
# https://ai.google.dev
GEMINI_API_KEY=
